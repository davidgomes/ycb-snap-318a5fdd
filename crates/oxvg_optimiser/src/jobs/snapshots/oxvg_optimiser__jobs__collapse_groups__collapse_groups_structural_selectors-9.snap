    <!-- Should preserve attributes and position relied on by negations -->
    <style>
        path:not(:nth-child(2)){fill:red}svg circle:not([fill]){stroke:red}
    </style>
    <g>
        <path d=""/>
    </g>
    <g fill="#00f">
        <circle r="1"/>
    </g>
