---
<svg xmlns="http://www.w3.org/2000/svg">
    <!-- Should preserve groups that would change the index of a sibling -->
    <style>
        path:nth-child(4){fill:red}circle:nth-of-type(2){fill:red}
    </style>
    <g>
        <rect width="1"/>
        <rect width="1"/>
    </g>
    <circle r="1"/>
    <path d=""/>
    <g>
        <circle r="1"/>
    </g>
    <circle r="1"/>
    <rect width="1"/>
</svg>
